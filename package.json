{
    "name": "@bric/rex-local-search",
    "version": "0.0.1",
    "description": "REX module that manipulates local search and mapping widgets.",
    "keywords": [
        "extension",
        "rex"
    ],
    "author": "Behavioral Research Innovation Center",
    "type": "module",
    "main": "index.mts",
    "homepage": "https://github.com/bric-digital/rex-local-search",
    "bugs": {
        "url": "https://github.com/bric-digital/rex-local-search/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bric-digital/rex-local-search.git"
    },
    "exports": {
        "./extension": "./src/extension.mts",
        "./browser": "./src/browser.mts",
        "./service-worker": "./src/service-worker.mts"
    },
    "scripts": {
        "build": "tsc",
        "lint": "eslint src",
        "pretest": "node tests/scripts/build-test-bundle.js",
        "test": "playwright test",
        "test:ci": "playwright test --reporter=dot",
        "test:debug": "playwright test --debug",
        "test:headed": "playwright test --headed",
        "test:ui": "playwright test --ui",
        "test:unit": "playwright test specs/",
        "server": "node tests/scripts/run-server.js"
    },
    "dependencies": {
        "@bric/rex-core": "github:bric-digital/rex-core",
        "@bric/rex-types": "github:bric-digital/rex-types",
        "check-types": "^11.2.3",
        "chrome-types": "^0.1.436",
        "psl": "^1.15.0"
    },
    "devDependencies": {
        "@types/check-types": "^11.2.2",
        "@types/slug": "^5.0.9",
        "express": "^5.3.0"
    }
}
