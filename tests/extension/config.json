{
    "configuration_url": "config.json",
    "identifier": "rex-local-search-test",
    "local_search": {
      "enabled": true,
      "debug": true,
      "sites": {
        "google": {
          "id": "google",
          "initial_obscure": true,
          "styles": {
            "rex-local-search-result": "border: solid red 2px;",
            "rex-local-search-widget": "border: solid orange 2px;",
            "rex-local-search-widget-row": "border: solid blue 2px;",
            "rex-local-search-widget-map": "border: solid black 2px;",
            "rex-local-search-detail-widget": "border: dashed red 2px;",
            "rex-local-search-ai-widget": "border: dotted red 2px;",
            "rex-local-search-ai-widget-row": "border: dotted red 2px;",
            "rex-local-search-ai-widget-map": "border: dotted red 2px;"
          },
          "manipulations": {
            "rex-local-search-widget": {
              "operation": "collapse",
              "offset": 0,
              "title": "Local results for {{query}}",
              "descriptions": "Nearby: {{placelist:3}}",
              "icon": "extension:google-logo",
              "preview": "results.0.preview|extension:google-static-map"
            }, 
            "rex-local-search-ai-widget-off": {
              "operation": "hide"
            }
          }
        }
      }
    },
    "ui": [{
        "title": "REX Local Search Testing Extension",
        "identifier": "main",
        "default": true
    }]
}
